{
  "name": "which-bin-sorter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Which Bin? One photo or typed name of one household item -> a deterministic, sourced bin answer, one clarifying question, or an abstention with a reason code.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "validate-rules": "tsx scripts/validate-rules.ts rules/fixture-city.json --mode fixture --stale warn",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.14.0",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.1.1",
    "eslint": "9.24.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.0.0",
    "jsdom": "26.0.0",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.29.0",
    "vite": "6.2.6",
    "vitest": "3.1.1"
  }
}
