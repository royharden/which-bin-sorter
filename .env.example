# Public frontend placeholders only. No real keys or project URLs are committed.
VITE_APP_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Configure the following in edge-function server settings, never VITE_ variables.
# ANTHROPIC_API_KEY: owner-supplied provider secret
# CLIENT_HASH_SALT: owner-generated server salt
# LIVE_MODEL_ENABLED=false (explicit true required for paid dispatch)
# DAILY_BUDGET_USD: owner-authorized positive limit, no spend granted here
# ALLOWED_ORIGINS: comma-separated exact allowed browser origins
# FUNCTION_MOCK_MODE=false (activation smoke-test switch only; live UI rejects mock)
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: platform-injected, verify at activation

# Local evaluation process only; never expose to browser.
# ANTHROPIC_API_KEY, LIVE_MODEL_ENABLED=true, EVAL_BUDGET_USD
# Evaluation also requires root config/model.json and verified config/prices.json.
